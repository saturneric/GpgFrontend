{
  "schema": 1,
  "slug": "gpgfrontend",
  "bases": {
    "update": ["https://update.bktus.com/"],
    "builds": ["https://builds.bktus.com/"]
  },
  "nightly_retention_days": 30,
  "notes_link_hosts": [
    "bktus.com",
    "*.bktus.com",
    "github.com/saturneric/GpgFrontend"
  ],
  "artifact_kinds": [
    "appimage",
    "msi",
    "msix",
    "zip",
    "dmg",
    "app-zip",
    "apk",
    "aab"
  ],
  "artifact_prefix": "GpgFrontend-",
  "artifacts": [
    {
      "match": "^(?:qt6-)?linux-(?P<arch>x86_64|aarch64)\\.AppImage$",
      "os": "linux",
      "arch": "{arch}",
      "kind": "appimage",
      "flavor": "installed"
    },
    {
      "match": "^linux-(?P<arch>x86_64|aarch64)-portable\\.AppImage$",
      "os": "linux",
      "arch": "{arch}",
      "kind": "appimage",
      "flavor": "portable"
    },
    {
      "match": "^qt5-linux-x86_64\\.AppImage$",
      "os": "linux",
      "arch": "x86_64",
      "kind": "appimage",
      "flavor": "qt5"
    },
    {
      "match": "^(?:qt6-)?windows-x86_64(?:-setup)?\\.msi$",
      "os": "windows",
      "arch": "x86_64",
      "kind": "msi",
      "flavor": "installed"
    },
    {
      "match": "^windows-x86_64\\.msix$",
      "os": "windows",
      "arch": "x86_64",
      "kind": "msix",
      "flavor": "installed"
    },
    {
      "match": "^(?:qt6-)?windows-x86_64-portable\\.zip$",
      "os": "windows",
      "arch": "x86_64",
      "kind": "zip",
      "flavor": "portable"
    },
    {
      "match": "^qt5-windows-x86_64-portable\\.zip$",
      "os": "windows",
      "arch": "x86_64",
      "kind": "zip",
      "flavor": "qt5"
    },
    {
      "match": "^android-(?P<arch>arm64-v8a|x86_64)\\.apk$",
      "os": "android",
      "arch": "{arch}",
      "kind": "apk",
      "flavor": "installed"
    },
    {
      "match": "^macos-(?P<major>\\d+)-intel\\.dmg$",
      "os": "macos",
      "arch": "x86_64",
      "kind": "dmg",
      "flavor": "installed",
      "min_os": {
        "macos": "{major}.0"
      }
    },
    {
      "match": "^macos-(?P<major>1[0-3])\\.dmg$",
      "os": "macos",
      "arch": "x86_64",
      "kind": "dmg",
      "flavor": "installed",
      "min_os": {
        "macos": "{major}.0"
      }
    },
    {
      "match": "^macos-(?P<major>\\d+)\\.dmg$",
      "os": "macos",
      "arch": "arm64",
      "kind": "dmg",
      "flavor": "installed",
      "min_os": {
        "macos": "{major}.0"
      }
    }
  ]
}
