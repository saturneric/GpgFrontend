#pragma once

/**
 * Logic Version (*.*.*)
 */
#define VERSION_MAJOR "@CMAKE_PROJECT_VERSION_MAJOR@"
#define VERSION_MINOR "@CMAKE_PROJECT_VERSION_MINOR@"
#define VERSION_PATCH "@CMAKE_PROJECT_VERSION_PATCH@"

/**
 * Code Version (According to Git)
 */
#define GIT_BRANCH_NAME "@GIT_BRANCH_NAME@"
#define GIT_COMMIT_HASH "@GIT_COMMIT_HASH@"

/**
 * Generated Information (According to CMake)
 */
#define BUILD_VERSION "@BUILD_VERSION@"
#define GIT_VERSION "@GIT_VERSION@"

/**
 * Build Information
 */
#define BUILD_FLAG "@BUILD_FLAG@"
#define BUILD_TIMESTAMP "@BUILD_TIMESTAMP@"
#define APP_INSTALL_FLAG "@APP_INSTALL_FLAG@"

/**
 * @brief Network
 *
 */
#define HTTP_REQUEST_USER_AGENT "@HTTP_REQUEST_USER_AGENT@"

/**
 * @brief App Display Name
 *
 */
#define APP_DISPLAY_NAME "@GPGFRONTEND_APP_DISPLAY_NAME@"

/**
 * @brief On-disk profile identity
 *
 * APP_PROFILE_NAME becomes QCoreApplication::applicationName(), which decides
 * the QSettings scope and the AppLocalData directory. It differs from
 * APP_DISPLAY_NAME on purpose: the display name is cosmetic and may contain
 * spaces, this one is a path and registry component.
 *
 * APP_PROFILE_SCHEMA_VERSION is the layout version of that directory: bump it
 * for any change to the layout at all, breaking or not.
 *
 * APP_PROFILE_MIN_READER_SCHEMA is the oldest build that may still touch what
 * this one writes. Bump it only when a change genuinely makes the profile
 * unintelligible to older builds -- which is far rarer than a layout change,
 * and is the whole reason these are two numbers instead of one. Raising it
 * needlessly locks users out of their own profiles after a downgrade.
 */
#define APP_PROFILE_NAME "@GPGFRONTEND_APP_PROFILE_NAME@"
#define APP_BUILD_STABLE @GPGFRONTEND_BUILD_STABLE_INT@
#define APP_BUILD_PORTABLE @GPGFRONTEND_BUILD_PORTABLE_INT@
#define APP_PROFILE_SCHEMA_VERSION 3
#define APP_PROFILE_MIN_READER_SCHEMA 1