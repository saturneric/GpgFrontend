<!-- The activity's theme while it starts: its window is the loading page
     (gf_splash) from the very first frame. Android 9 has no DayNight theme;
     values-v29 uses it from Android 10 on. -->
<resources>
    <style name="GfLaunch" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/gf_splash</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
