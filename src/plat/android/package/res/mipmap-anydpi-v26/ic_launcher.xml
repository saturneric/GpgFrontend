<!-- The desktop icon (com.bktus.gpgfrontend.png) as an adaptive icon: its
     white shield inside the safe zone (66 of 108 dp) on its blue, which the
     launcher shapes. The shield alone is the themed (monochrome) icon.
     Android 12+ also shows it on the launch splash. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/gf_launcher_background" />
    <foreground android:drawable="@drawable/gf_launcher_foreground" />
    <monochrome android:drawable="@drawable/gf_launcher_foreground" />
</adaptive-icon>
