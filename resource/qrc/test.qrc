        <file alias="enc_symmetric_v2.pgp">../lfs/test/rpgp_vectors/enc_symmetric_v2.pgp</file>
        <file alias="enc_sed_tag9.pgp">../lfs/test/rpgp_vectors/enc_sed_tag9.pgp</file>
